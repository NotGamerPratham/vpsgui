# VPSGUI Production Build Environment
#
# VITE_* values are inlined into the public client bundle at build time. Never put secrets here.

VITE_APP_TITLE=VPSGUI Open Infrastructure Workspace

# Intentionally unset: the client derives `${window.location.origin}/api/v1`, which deploy/nginx.conf
# proxies to the agent on 127.0.0.1:46509. Hard-coding a host here breaks every other deployment.
# VITE_API_BASE_URL=

# Intentionally unset: the bundled agent serves no WebSocket endpoint; telemetry is polled over REST.
# VITE_WS_URL=

VITE_DEFAULT_THEME=vscode-dark
