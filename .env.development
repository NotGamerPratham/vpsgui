# VPSGUI Local Development Configuration
#
# VITE_* values are inlined into the client bundle at build time — never put secrets here.

VITE_APP_TITLE=VPSGUI Open Infrastructure Workspace (Dev)

# VITE_API_BASE_URL is intentionally unset — vite.config.js proxies /api/v1 to the agent on
# 127.0.0.1:46509, keeping dev requests same-origin. Point the proxy elsewhere with VITE_AGENT_ORIGIN.
# It previously pointed at http://localhost:8080/api/v1, where nothing listens.
# VITE_API_BASE_URL=

# Unset: the agent has no WebSocket endpoint; telemetry is polled over REST.
VITE_WS_URL=

VITE_DEFAULT_THEME=vscode-dark
