[Unit]
Description=VPSGUI Linux Infrastructure Telemetry Agent
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/vpsgui/agent
ExecStart=/usr/bin/node /var/www/vpsgui/agent/server.js
Restart=always
RestartSec=3s
Environment=PORT=46509
# Set a fixed shared secret here (or let the agent auto-generate/persist one to agent/.agent-token).
# Environment=AGENT_TOKEN=replace-with-a-long-random-value

[Install]
WantedBy=multi-user.target
