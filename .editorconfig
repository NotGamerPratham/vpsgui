# EditorConfig for VPSGUI
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
end_of_line = lf
indent_size = 2

[*.json]
indent_size = 2

[*.py]
indent_size = 4

[Dockerfile]
indent_size = 2
