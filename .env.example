# VPSGUI Production Environment Variables

# REST API Base URL (defaults to window.location.origin/api/v1 when deployed on VPS)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Telemetry WebSocket URL
VITE_WS_URL=ws://localhost:8080/ws

# Authentication Provider Configuration
VITE_AUTH_PROVIDER=jwt
VITE_ENABLE_MFA=true

# Agent Download Mirror URL
VITE_AGENT_DOWNLOAD_URL=https://get.vpsgui.dev/agent.sh
