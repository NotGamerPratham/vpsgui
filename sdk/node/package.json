{
  "name": "vpsgui-sdk",
  "version": "1.1.0",
  "description": "Official Node.js/TypeScript SDK for the VPSGUI agent REST API - host telemetry, Docker, files, firewall, secrets, backups and shell execution.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vpsgui",
    "vps",
    "server",
    "infrastructure",
    "docker",
    "linux",
    "monitoring",
    "telemetry",
    "devops",
    "sdk",
    "api-client"
  ],
  "author": "NotGamerPratham <https://notgamerpratham.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotGamerPratham/vpsgui.git",
    "directory": "sdk/node"
  },
  "homepage": "https://github.com/NotGamerPratham/vpsgui",
  "bugs": {
    "url": "https://github.com/NotGamerPratham/vpsgui/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
