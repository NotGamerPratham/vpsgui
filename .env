# VPSGUI local development defaults.
#
# VITE_* values are inlined into the client bundle at build time — never put secrets here.
# The agent token is entered at runtime under Settings -> Agent Token.

VITE_APP_NAME=VPSGUI
VITE_APP_VERSION=1.0.0

# VITE_API_BASE_URL is intentionally unset.
#
# The client falls back to `${window.location.origin}/api/v1`, and vite.config.js proxies that path
# to the agent on 127.0.0.1:46509 — so dev requests are same-origin, exactly as they are behind
# nginx in production. Setting an absolute URL here makes them cross-origin, which the agent now
# rejects unless the origin is listed in AGENT_ALLOWED_ORIGINS.
#
# This previously pointed at http://localhost:8080/api/v1, where nothing listens.
# VITE_API_BASE_URL=

# Unset: the agent has no WebSocket endpoint; telemetry is polled over REST.
VITE_WS_URL=
