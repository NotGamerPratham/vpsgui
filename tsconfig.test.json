{
  // The root tsconfig only includes "src", so tests were never type-checked at all — every test
  // file could reference removed exports or wrong signatures and nothing would notice.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "noEmit": true
  },
  "include": ["tests", "src"]
}
